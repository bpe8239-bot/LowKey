/* USER CODE BEGIN 0 */

/*Bluetooth Keybind command*/
static void handleBtCommand(char c)
{
    const char *motion = NULL;
    char line[90];

    if (pidTuneKey(c)) return;      /* Kp/Kd entry must come first */

    if (c == '\r' || c == '\n') return;

    if (c >= '1' && c <= '9')
    {
        speed = 300 + (c - '1') * 87;  /* 1..9 -> 300..996 */
        lastCmdTime = HAL_GetTick();
        snprintf(line, sizeof(line), "[SPEED] PWM = %d / 999\r\n", speed);
        btPrint(line);
        return;
    }
        if (c == 'M' || c == 'm')
        {
            autoMode = 1;
            sensorOnly = 0;
            lineFollowReset();
            btPrint("[MODE] AUTO LINE FOLLOWING\r\n");
            return;
        }
	if (c == 'I' || c == 'i')
	{
		autoMode = 0;
		sensorOnly = 1;
		cmd = 'X';
		stopMotors();
		btPrint("[MODE] IR MONITOR (motors stopped)\r\n");
		return;
	}
	if (c == 'X' || c == 'x' || c == ' ') /*Stop motor command*/
	{
		autoMode = 0;
		sensorOnly = 0;
		cmd = 'X';
		stopMotors();
		btPrint("[MOTOR] STOP\r\n");
		return;
	}
	if (c == '?' || c == 'H' || c == 'h') /*List of Command*/
	{
		btPrint("[HELP] W/S/A/D move; X stop; M auto; I IR monitor; 1-9 speed; KP<n>/KD<n> tune, K show; ? help\r\n");
		return;
	}

	if (c == 'F' || c == 'f') /*claw control keybind*/
	{
	    Claw_Open();
	    btPrint("[CLAW] OPEN\r\n");
	    return;
	}

	if (c == 'G' || c == 'g')
	{
	    Claw_Close();
	    btPrint("[CLAW] CLOSE\r\n");
	    return;
	}

	if (c == 'W' || c == 'w') motion = "FORWARD";
	else if (c == 'S' || c == 's') motion = "BACKWARD";
	else if (c == 'A' || c == 'a') motion = "LEFT";
	else if (c == 'D' || c == 'd') motion = "RIGHT";

	if (motion != NULL)
	{
		autoMode = 0;
		sensorOnly = 0;
		cmd = c;
		lastCmdTime = HAL_GetTick();
		snprintf(line, sizeof(line), "[MOTOR] %s | Speed: %d\r\n", motion, speed);
		btPrint(line);
	}
	else
	{
		snprintf(line, sizeof(line), "[ERROR] Unknown command: %c\r\n", c);
		btPrint(line);
	}
	}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM2_Init();
  MX_USART1_UART_Init();
  MX_TIM3_Init();
  MX_I2C1_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2);
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_3);
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_4);
    stopMotors();

    lastCmdTime = HAL_GetTick();
    if (Bluetooth_Start() != HAL_OK)
    {
        Error_Handler();
    }

    /* start listening to Bluetooth */
  btPrint("[STM32] Ready. Send ? for help.\r\n");

    if (Claw_Init(&htim3) != HAL_OK)
    {
        Error_Handler();
    }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    uint8_t received;
    while (btPop(&received))
    {
      handleBtCommand((char)received);
    }

    if (autoMode)
    {
      lineFollow(speed);
    }
    else if (sensorOnly)
    {
      monitorIR();
    }
    else
    {
      if (cmd != 'X' && cmd != 'x' && cmd != ' ' &&
          HAL_GetTick() - lastCmdTime >= CMD_TIMEOUT_MS)
      {
        cmd = 'X';
        stopMotors();
        btPrint("[SAFETY] Manual command timeout: STOP\r\n");
      }
      switch (cmd)
      {
        case 'W': case 'w': forward(speed);   break;
        case 'S': case 's': backward(speed);  break;
        case 'A': case 'a': turnLeft(speed);  break;
        case 'D': case 'd': turnRight(speed); break;
        default: stopMotors(); break;
      }
    }

  }
  /* USER CODE END 3 */
}

